# Pulse environment configuration — copy to .env (gitignored, NEVER commit .env).
# All values are placeholders. Secrets live in env vars at runtime ONLY.
# Generate an API key with: ./zig-out/bin/pulse keygen

# API server
PULSE_PORT=9000
PULSE_HOST=0.0.0.0
PULSE_API_KEY=
# Previous key, accepted alongside PULSE_API_KEY during rotation
# (Roadmap 5.1). Remove once clients have migrated to the new key.
PULSE_API_KEY_PREVIOUS=
PULSE_LOG_LEVEL=info

# Rate limits (per API key)
PULSE_RATE_LIMIT_PER_MINUTE=100
PULSE_RATE_LIMIT_PER_DAY=10000

# PostgreSQL (leave empty to run with the in-memory store)
DATABASE_URL=postgres://pulse:pulse@postgres:5432/pulse

# Redis (leave empty to run without cache/streams)
REDIS_URL=redis://redis:6379

# MinIO raw archive (leave empty to skip archiving)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=pulse-raw

# Worker ingestion interval (seconds)
PULSE_INGEST_INTERVAL_S=300
